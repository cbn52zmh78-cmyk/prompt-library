# Model adapter weights — large binary files, keep on disk/Drive only
models/adapters/**/*.safetensors
models/adapters/**/checkpoint-*/
models/adapters/**/checkpoint-*/

# Python cache
__pycache__/
*.pyc
*.pyo
training/__pycache__/

# venv
ml_env/

# Video files — never commit (stored on disk + Drive only)
*.mp4
*.mov
*.wav
*.avi
*.mkv
*.webm

# ── LARGE FILES — no multi-GB files in git, ever ──
# ML weights (catch-all beyond adapter-specific rules above)
*.bin
*.pt
*.pth
*.gguf
*.onnx
# Raster / GIS / data
*.tif
*.tiff
*.parquet
*.geojson
# 3D models
*.blend
*.glb
*.gltf
*.dae
*.obj
*.stl
*.fbx
*.exr
# Archives
*.tar.gz
*.zip
