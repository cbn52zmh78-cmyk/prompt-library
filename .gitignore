__pycache__/
*.py[cod]
.venv/
venv/
.env
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Cursor / Grok session state (environment-specific)
terminals/
mcps/

# Studio generated outputs
Studio/renders/
Studio/Batch_Outputs/
Studio/Video_Prompts/compiled_*.json
Studio/Tool_Logs/

# DAVID brain scrape cache (keep scrape_log.json)
DAVID/data/brain_cache/20*.json
DAVID/reports/brain_report_*.md

# Artifacts local DB / scratch
artifacts/**/*.db
artifacts/**/.streamlit/

# Test / build artifacts
.pytest_cache/
*.egg-info/
dist/
build/

# Test scratch dirs (e.g. _t173_tmp, _t212_tmp) created by test suites
**/_t[0-9]*_tmp/

# Personal secrets (HuggingFace API token, etc.)
(ME)/HIUGGINGFACE.txt

# DAVID production video renders (kept on disk, not committed)
DAVID/productions/**/*.mp4

# Training adapter archives (large binaries, never commit)
adapter.tar.gz
*.tar.gz

# Claude local settings
.claude/

# Agent-tools ephemeral outputs
agent-tools/*.txt

# Global video exclusion — no video files in any submodule or path
*.mp4
*.mov
*.wav
*.avi
*.mkv
*.webm

# Eval report JSON (ephemeral, keep on disk only)
*_eval_report.json

# Unsloth auto-generated compiled trainer cache (regenerable)
unsloth_compiled_cache/
